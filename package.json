{
  "name": "landx-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LandX / arsam.net — AI-first arsa marketplace frontend (demo prototype)",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "build:demo": "cross-env VITE_ROUTER_MODE=hash VITE_DEMO_MODE=true react-router build && node scripts/copy-404.mjs",
    "preview": "react-router-serve ./build/server/index.js || vite preview --outDir build/client",
    "typecheck": "tsc --noEmit && react-router typegen",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "i18n:lint": "tsx src/i18n/lint.ts",
    "msw:init": "msw init public/ --save"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-router/node": "^7.1.0",
    "@react-router/serve": "^7.1.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "flowbite": "^2.5.2",
    "flowbite-react": "^0.10.2",
    "i18next": "^24.0.5",
    "i18next-browser-languagedetector": "^8.0.0",
    "isbot": "^5.1.17",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^4.7.1",
    "motion": "^11.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-i18next": "^15.1.2",
    "react-router": "^7.1.0",
    "recharts": "^2.13.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.5",
    "vaul": "^1.1.2",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@faker-js/faker": "^9.3.0",
    "@playwright/test": "^1.49.0",
    "@react-router/dev": "^7.1.0",
    "@tailwindcss/vite": "^4.0.0-beta.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.10.2",
    "axe-playwright": "^2.0.3",
    "cross-env": "^7.0.3",
    "jsdom": "^25.0.1",
    "msw": "^2.6.8",
    "tailwindcss": "^4.0.0-beta.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  },
  "msw": {
    "workerDirectory": ["public"]
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react-native"]
    }
  }
}
