# LandX / arsam.net — environment example
# Copy to .env.local for local development. DO NOT commit .env files.

# --- Build-time switches (PROMPT R-01, R-05) ---
# Persona Switcher visibility. true = visible (demo build), false = tree-shaken (prod).
VITE_DEMO_MODE=true

# Router mode. browser = clean URLs (production). hash = #/ URLs (GitHub Pages demo).
VITE_ROUTER_MODE=browser

# --- API ---
# Empty during MSW mock-first phase. Set when real backend is reachable.
VITE_API_BASE_URL=

# --- Optional integrations (default OFF for prototype) ---
VITE_ENABLE_POSTHOG=false
VITE_POSTHOG_KEY=

# --- MCP integrations ---
# GitHub PAT for the github MCP server. Use a fine-scoped token. Do NOT commit.
# GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxx
